[Unit]
Description=Deprecated CubeRanks server-local WCA ranking sync
Documentation=https://github.com/coder13/wcarankings-2/actions/workflows/refresh-rankings.yml
ConditionPathExists=/srv/wcarankings/ENABLE_DEPRECATED_SERVER_REFRESH

[Service]
Type=oneshot
User=www
WorkingDirectory=/srv/wcarankings
ExecStart=/bin/sh -lc 'echo "Deprecated: production WCA data refreshes must be initiated by GitHub Actions only. Use the Refresh Ranking Data workflow." >&2; exit 1'
