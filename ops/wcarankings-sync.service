[Unit]
Description=Sync CubeRanks WCA rankings
Requires=docker.service
After=docker.service
OnFailure=wcarankings-sync-alert.service

[Service]
Type=oneshot
User=www
WorkingDirectory=/srv/wcarankings
ExecStart=/usr/bin/flock -n /tmp/wcarankings-sync.lock /bin/sh -lc '/usr/bin/docker compose run --rm flyway migrate && /usr/bin/docker compose run --rm app node /app/scripts/sync-wca-export.mjs && /usr/bin/docker compose run --rm app node /app/scripts/check-ranking-projections.mjs'
