MYSQL_DATABASE=wcarankings
MYSQL_USER=wcarankings
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=mysql://wcarankings:replace-with-a-long-random-password@db:3306/wcarankings
DATABASE_POOL_MAX=5
DATABASE_QUEUE_LIMIT=20
RANKINGS_STATEMENT_TIMEOUT_MS=2000
WCA_EXPORT_CACHE_DIR=/var/cache/wcarankings
WCA_SQL_EXPORT_PATH=

# Local `npm run dev` falls back to WCA staging's example credentials. Set real
# credentials only for a deployed environment; production rejects the example values.
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=
WCA_REDIRECT_URI=http://localhost:3000/api/auth/wca/callback
WCA_ORIGIN=https://www.worldcubeassociation.org
