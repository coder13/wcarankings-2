FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable \
  && pnpm install --frozen-lockfile --prod \
  && pnpm store prune

FROM oven/bun:1.3.3-debian

WORKDIR /app

RUN useradd --system --uid 10001 --create-home data-tools \
  && apt-get update \
  && apt-get install --yes --no-install-recommends mariadb-client \
  && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /app/node_modules ./node_modules

COPY --chown=data-tools:data-tools release-compatibility.json ./
COPY --chown=data-tools:data-tools data-tools ./data-tools
COPY --chown=data-tools:data-tools scripts ./scripts
COPY --chown=data-tools:data-tools components ./components
COPY --chown=data-tools:data-tools db ./db
COPY --chown=data-tools:data-tools lib ./lib
COPY --chown=data-tools:data-tools services ./services
COPY --chown=data-tools:data-tools tsconfig.json ./tsconfig.json
COPY --chown=data-tools:data-tools sql ./sql
COPY --chown=data-tools:data-tools migrations/mysql ./migrations/mysql

RUN mkdir -p /var/cache/wcarankings \
  && chown data-tools:data-tools /var/cache/wcarankings

USER data-tools

ENTRYPOINT ["bun"]
