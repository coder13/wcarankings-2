{
  "name": "@wcarankings/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node dist/standalone/server.js",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build",
    "lint": "eslint . --max-warnings 0 --ignore-pattern dist --ignore-pattern .next --ignore-pattern storybook-static",
    "lint:unused": "knip --reporter compact",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental false",
    "test:unit": "node --import ./tests/register-asset-loader.mjs --import tsx --test components/*.test.tsx components/*/*.test.tsx tests/*.test.ts",
    "validate:pages": "bun scripts/validate-pages.ts",
    "benchmark:ranking-scroll": "bun scripts/benchmark-ranking-scroll.ts",
    "benchmark:ranking-scroll:persons": "bun scripts/benchmark-ranking-persons.ts",
    "benchmark:ranking-scroll:results": "bun scripts/benchmark-ranking-results.ts",
    "benchmark:ranking-scroll:competitions": "bun scripts/benchmark-ranking-competitions.ts",
    "benchmark:ranking-scroll:cities": "bun scripts/benchmark-ranking-cities.ts",
    "benchmark:ranking-scroll:medals": "bun scripts/benchmark-ranking-medals.ts",
    "benchmark:ranking-scroll:pr-streak": "bun scripts/benchmark-ranking-pr-streak.ts"
  },
  "dependencies": {
    "@wcarankings/projection-jobs": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.5",
    "i18next": "^26.3.6",
    "lru-cache": "^11.5.2",
    "motion": "^12.43.0",
    "mysql2": "^3.23.2",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-ga4": "^3.0.1",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "sql-template-tag": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@storybook/nextjs-vite": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.31.0",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "storybook": "^10.5.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vite-plugin-svgr": "^5.2.0"
  }
}
