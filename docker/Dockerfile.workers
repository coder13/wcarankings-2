FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/live-results-worker/package.json ./apps/live-results-worker/package.json
COPY apps/projection-worker/package.json ./apps/projection-worker/package.json
RUN corepack enable \
  && pnpm install --frozen-lockfile --prod \
  && pnpm store prune

FROM docker.io/oven/bun:1.3.3-debian

WORKDIR /app

RUN useradd --system --uid 10001 --create-home wcarankings \
  && apt-get update \
  && apt-get install --yes --no-install-recommends mariadb-client \
  && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps ./apps
COPY --from=dependencies /app/packages ./packages
COPY --chown=wcarankings:wcarankings apps/live-results-worker ./apps/live-results-worker
COPY --chown=wcarankings:wcarankings apps/projection-worker ./apps/projection-worker
COPY --chown=wcarankings:wcarankings tsconfig.data-tools.json ./tsconfig.data-tools.json

USER wcarankings

ENTRYPOINT ["bun"]
