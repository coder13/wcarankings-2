{
  "name": "wcarankings-2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build",
    "start": "node dist/standalone/server.js",
    "db:migrate": "docker compose --env-file .env.local run --rm flyway migrate",
    "db:refresh-rankings": "node --env-file-if-exists=.env.local scripts/refresh-rankings.mjs",
    "db:refresh-system-lists": "node --env-file-if-exists=.env.local scripts/refresh-system-lists.mjs",
    "db:backfill-result-rankings": "node --env-file-if-exists=.env.local scripts/backfill-result-rankings.mjs",
    "db:build-gender-result-rankings": "node --env-file-if-exists=.env.local scripts/build-gender-result-rankings.mjs",
    "db:backfill-person-year-rankings": "node --env-file-if-exists=.env.local scripts/backfill-person-year-rankings.mjs",
    "test": "npm run build && node --test tests/deploy-workflow.test.mjs tests/projection-transfer.test.mjs tests/rendered-html.test.mjs tests/scroll-engine.test.mjs tests/result-projections.test.mjs",
    "test:unit": "node --import ./tests/register-asset-loader.mjs --import tsx --test components/*/*.test.tsx tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern storybook-static",
    "sync:wca": "node scripts/sync-wca-export.mjs",
    "sync:wca:local": "docker compose --env-file .env.local run --rm flyway migrate && node --env-file=.env.local scripts/sync-wca-export.mjs",
    "load:rankings": "node scripts/load-rankings.mjs"
  },
  "dependencies": {
    "@cubing/icons": "^3.0.5",
    "@tanstack/react-virtual": "^3.14.5",
    "lru-cache": "^11.5.2",
    "mysql2": "^3.23.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-ga4": "^3.0.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@storybook/nextjs-vite": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "storybook": "^10.5.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vite-plugin-svgr": "^5.2.0"
  },
  "type": "module"
}
