{
  "name": "wcarankings-2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "turbo": "turbo",
    "dev": "pnpm --filter @wcarankings/web dev",
    "build": "pnpm --filter @wcarankings/web build",
    "storybook": "pnpm --filter @wcarankings/web storybook",
    "build-storybook": "pnpm --filter @wcarankings/web build-storybook",
    "start": "pnpm --filter @wcarankings/web start",
    "validate:pages": "pnpm --filter @wcarankings/web validate:pages",
    "db:migrate": "docker compose --env-file .env.local run --rm flyway migrate",
    "db:refresh-rankings": "bun --env-file-if-exists=.env.local scripts/refresh-rankings.ts",
    "projection:process-job": "bun --env-file-if-exists=.env.local scripts/process-projection-job.ts",
    "db:refresh-system-lists": "bun --env-file-if-exists=.env.local scripts/refresh-system-lists.ts",
    "db:refresh-board-list": "bun --env-file-if-exists=.env.local scripts/refresh-board-list.ts",
    "db:refresh-delegates-list": "bun --env-file-if-exists=.env.local scripts/refresh-board-list.ts --delegates",
    "test": "pnpm run build && node --test tests/release-compatibility.test.mjs && bun test tests/person-lookup-index.integration.test.mjs tests/chunk-projection-dump.test.mjs tests/projection-build.test.mjs tests/projection-deployment-plan.test.mjs tests/projection-release-artifact.test.mjs tests/projection-release-plan.test.mjs tests/projection-table-usage.test.mjs tests/ranking-generation-activation.test.mjs tests/projection-transfer.test.mjs",
    "test:unit": "pnpm --filter @wcarankings/web test:unit",
    "test:integration": "bun test tests/ranking-generation-activation.integration.test.mjs",
    "lint": "pnpm --filter @wcarankings/web lint && bun scripts/lint-projection-table-usage.ts && pnpm run lint:unused",
    "lint:unused": "pnpm --filter @wcarankings/web lint:unused",
    "typecheck": "pnpm --filter @wcarankings/web typecheck",
    "data-tools:typecheck": "bunx tsc --project tsconfig.data-tools.json",
    "test:projections": "bun test tests/projection-*.test.mjs tests/ranking-generation-activation.test.mjs tests/projection-transfer.test.mjs",
    "sync:wca": "bun scripts/sync-wca-export.ts",
    "sync:wca:local": "docker compose --env-file .env.local run --rm flyway migrate && bun --env-file=.env.local scripts/sync-wca-export.ts",
    "benchmark:ranking-scroll": "pnpm --filter @wcarankings/web benchmark:ranking-scroll",
    "benchmark:ranking-scroll:persons": "pnpm --filter @wcarankings/web benchmark:ranking-scroll:persons",
    "benchmark:ranking-scroll:results": "pnpm --filter @wcarankings/web benchmark:ranking-scroll:results",
    "benchmark:ranking-scroll:competitions": "pnpm --filter @wcarankings/web benchmark:ranking-scroll:competitions",
    "benchmark:ranking-scroll:cities": "pnpm --filter @wcarankings/web benchmark:ranking-scroll:cities",
    "benchmark:ranking-scroll:medals": "pnpm --filter @wcarankings/web benchmark:ranking-scroll:medals",
    "benchmark:ranking-scroll:pr-streak": "pnpm --filter @wcarankings/web benchmark:ranking-scroll:pr-streak",
    "benchmark:build:pr-streak": "bun --env-file-if-exists=.env.local scripts/benchmark-pr-streak-build.ts",
    "dev:web": "turbo dev --filter=@wcarankings/web",
    "dev:live-results-worker": "turbo dev --filter=@wcarankings/live-results-worker",
    "build:apps": "turbo build",
    "lint:workspace": "turbo lint",
    "typecheck:workspace": "turbo typecheck"
  },
  "dependencies": {
    "@wcarankings/cli": "workspace:*",
    "@wcarankings/database": "workspace:*",
    "@wcarankings/live-results": "workspace:*",
    "@wcarankings/projection-jobs": "workspace:*",
    "mysql2": "^3.23.2",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/unzipper": "^0.10.11",
    "eslint": "9.39.4",
    "prettier": "3.9.6",
    "prettier-plugin-sh": "0.19.0",
    "prettier-plugin-sql": "0.20.0",
    "turbo": "^2.8.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
